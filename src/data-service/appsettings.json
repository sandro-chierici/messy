{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DbConnection": "Server=localhost;Port=5432;Database=messy;User Id=messy;Password=xxxx;Timeout=10;CommandTimeout=20"
  },
  "Events": {
    "Transport": "Nats",
    "Outbox": {
      "BatchSize": 100,
      "PollInterval": "00:00:00.500",
      "MaxAttempts": 10,
      "SentRetention": "3.00:00:00"
    },
    "NatsJetStream": {
      "Url": "nats://localhost:4222",
      "StreamName": "EVENTS",
      "Subjects": [ "events.>" ],
      "Retention": "WorkQueue",
      "MaxAge": "7.00:00:00",
      "DuplicateWindow": "00:10:00",
      "Replicas": 1
    }
  },
  "FeatureFlag": {
    "Database": {
    }
  }
}
